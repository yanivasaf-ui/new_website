# Copy to .dev.vars for `wrangler dev`. In production set each with `wrangler secret put <NAME>`.
# Never commit real values.

# LLM (required for the live analysis; without it every result is the template fallback)
ANTHROPIC_API_KEY=
# Optional overrides
# ANTHROPIC_MODEL=claude-sonnet-4-6
# QUIZ_LLM_TIMEOUT_MS=12000
# QUIZ_LLM_EFFORT=             # low|medium|high; unset = model default
# QUIZ_LLM_FALLBACKS=default   # server-side refusal fallback; only for models that support it
# QUIZ_TEMPLATE_FALLBACK=0     # default is ON: an LLM failure returns a template result. 0 = show the error state instead
# ANTHROPIC_BASE_URL=          # testing only (point at a local stand-in server)

# Lead storage (Notion internal integration token + the quiz leads database id, shared with the integration)
NOTION_TOKEN=
NOTION_QUIZ_DB_ID=

# Email (Resend). LEAD_EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
LEAD_EMAIL_FROM=Ensemble Quiz <quiz@ensemble-ai.io>
LEAD_EMAIL_TO=asaf@ensemble-ai.io
